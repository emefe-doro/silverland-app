# Backend API environment
PORT=4000

# Database (local dev). For production use Supabase/Render Postgres pooler connection string.
DATABASE_URL="postgresql://silverland:silverland_dev_pass@localhost:5432/silverland?schema=public"

# Auth secret (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-a-long-random-secret"
ACCESS_TOKEN_EXPIRE_SECONDS=28800

# CORS allowed origins (the frontend URL). Comma-separated.
CORS_ORIGINS=http://localhost:3000

# Estate defaults (editable later in Settings)
DEFAULT_VISITOR_PASS_VALIDITY_HOURS=24
DEFAULT_DISPATCH_VALIDITY_MINUTES=45
DEFAULT_MAX_VISITOR_DURATION_HOURS=12
RESIDENTS_MUST_APPROVE_VISITORS=true
DISPATCH_REQUIRES_RESIDENT_CONFIRMATION=true
